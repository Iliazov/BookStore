<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - BookStore CRM</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" /> 
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-asp-append-version="true"/>

</head>

<body>

    @await Html.PartialAsync("Component/_AdminSidebar")

    <div class="main-content">

        @await Html.PartialAsync("Component/_AdminNavbar")

        <main class="page-content">

            @RenderBody()

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>