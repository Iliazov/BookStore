@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-body text-center">

            <h1 class="display-3 text-danger">
                @ViewBag.StatusCode
            </h1>

            <h3>@ViewBag.Title</h3>

            <p class="lead">
                @ViewBag.Message
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary mt-3">
                Go Home
            </a>

        </div>

    </div>

</div>