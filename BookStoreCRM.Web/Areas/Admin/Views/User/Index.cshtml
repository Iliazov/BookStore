@model List<BookStoreCRM.Web.Areas.Admin.ViewModels.User.UserViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Users</h2>
        <p class="text-muted mb-0">Manage registered users</p>
    </div>

    <span class="badge bg-light text-dark border px-3 py-2">
        Total: @Model.Count
    </span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-people fs-1 d-block mb-2"></i>
                <h5 class="text-dark">No users found</h5>
                <p class="mb-0">Registered users will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">User</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var fullName = $"{user.FirstName} {user.LastName}".Trim();
                            var initial = string.IsNullOrWhiteSpace(fullName)
                                ? "?"
                                : fullName[..1].ToUpperInvariant();

                            <tr class="user-row @(user.IsBlocked ? "blocked-user" : "")"
                                onclick="location.href='@Url.Action("UserDetail", "User", new { area = "Admin", id = user.Id })'">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(user.Avatar))
                                        {
                                            <img src="@user.Avatar"
                                                 alt="@fullName"
                                                 class="rounded-circle object-fit-cover"
                                                 width="42"
                                                 height="42" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-semibold"
                                                 style="width: 42px; height: 42px;">
                                                @initial
                                            </div>
                                        }

                                        <div>
                                            <a asp-area="Admin"
                                               asp-controller="User"
                                               asp-action="UserDetail"
                                               asp-route-id="@user.Id"
                                               class="fw-semibold text-dark text-decoration-none">
                                                @(string.IsNullOrWhiteSpace(fullName) ? "Unnamed user" : fullName)
                                            </a>
                                            <small class="text-muted">@user.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(string.IsNullOrWhiteSpace(user.Role) ? "No role" : user.Role)
                                    </span>
                                </td>
                                <td>
                                    @if (user.IsBlocked)
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Blocked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">Active</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
