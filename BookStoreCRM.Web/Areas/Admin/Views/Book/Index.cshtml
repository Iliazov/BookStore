@model List<BookStoreCRM.Web.Areas.Admin.ViewModels.Book.BookItemViewModel>
@{
	ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h2>Books</h2>

	@* <div class="d-flex gap-2"> *@
	@* 	<form asp-action="Search" method="get"> *@

	@* 	</form> *@
	@* </div> *@

	<a asp-action="Create" class="btn btn-primary">Create Book</a>
</div>

<table class="table table-hover table-bordered align-middle">
	<thead class="table-dark">
		<tr>
			<th>Image</th>
			<th>Title</th>
			<th>Author</th>
			<th>Description</th>
			<th>Price</th>
			<th style="width:180px">Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var book in Model)
		{
			<tr class="cursor:pointer"
				onclick="location.href='@Url.Action("BookDetail", "Book", new {area = "Admin", id=book.Id})'">
				<td><img src="@book.ImageUrl" alt="@book.Title" class="book-image" /></td>
				<td>@book.Title</td>
				<td>@book.Author</td>
				<td>@book.Description</td>
				<td>@book.Price</td>
				<td>
					<a asp-action="Edit"
					   asp-route-id="@book.Id"
					   class="btn btn-warning btn-sm">

						Edit

					</a>

					<form asp-action="Delete"
					  asp-route-id="@book.Id"
					  method="post"
					  style="display:inline;">

					@Html.AntiForgeryToken()

					<button type="submit"
							class="btn btn-danger btn-sm"
							onclick="return confirm('Are you sure you want to delete this book?');">
						Delete
					</button>
					</form>
				</td>
			</tr>
		}
	</tbody>
</table>
