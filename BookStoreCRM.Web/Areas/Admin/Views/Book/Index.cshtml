@model BookStoreCRM.Web.Areas.Admin.ViewModels.Book.BookIndexViewModel;
@{
	ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h2>Books</h2>

		<form class="d-flex gap-2"
			  asp-controller="Book"
			  asp-action="Index"
			  method="get">
			<input type="search"
				   id="bookSearch"
				   name="search"
				   value="@Model.Search"
				   placeholder="Name of book or author..."
				   aria-label="Search book"
				   class="form-control" />
			<button type="submit" class="btn btn-primary">Search</button>
		</form>

	<a asp-action="Create" class="btn btn-primary">Create Book</a>
</div>
<div class="card">
	<div class="card-body">
		<table class="table table-hover align-middle">
			<thead>
				<tr>
					<th>Image</th>
					<th>Title</th>
					<th>Author</th>
					<th>Price</th>
					<th style="width:180px">Actions</th>
				</tr>
			</thead>
			<tbody id="bookTableBody">
				@foreach (var book in Model.Books)
				{
					<tr class="cursor:pointer"
						onclick="location.href='@Url.Action("BookDetail", "Book", new { area = "Admin", id = book.Id })'">
						<td><img src="@book.ImageUrl" alt="@book.Title" class="book-image" /></td>
						<td>@book.Title</td>
						<td>@book.Author</td>
						<td>@book.Price</td>
						<td>
							<a asp-action="Edit"
							   asp-route-id="@book.Id"
							   class="btn btn-warning btn-sm">

								Edit

							</a>

							<form asp-action="Delete"
								  asp-route-id="@book.Id"
								  method="post"
								  style="display:inline;">

								@Html.AntiForgeryToken()

								<button type="submit"
										class="btn btn-danger btn-sm"
										onclick="return confirm('Are you sure you want to delete this book?');">
									Delete
								</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<div class="d-flex flex-column align-items-center mt-3">
			
			<div class="d-flex gap-2">
				@if (Model.HasPreviousPage)
				{
					<a asp-action="Index"
						asp-route-page="@(Model.CurrentPage-1)"
						asp-route-search="@Model.Search"
					class="btn btn-outline-primary">Previous</a>
				}else
				{
                    <button class="btn btn-outline-secondary" disabled>Previous</button>
				}
				@if (Model.HasNextPage)
				{
					<a asp-action="Index"
					asp-route-page="@(Model.CurrentPage + 1)"
					asp-route-search="@Model.Search"
					class="btn btn-outline-primary">Next</a>
				}
				else
				{
                    <button class="btn btn-outline-secondary" disabled>Next</button>
				}
			</div>
			<div class="mt-2 text-muted">
				Page @Model.CurrentPage of @Model.TotalPages
			</div>
		</div>
	</div>
</div>

<script src="~/js/book/bookSearch.js"
		asp-append-version="true"></script>