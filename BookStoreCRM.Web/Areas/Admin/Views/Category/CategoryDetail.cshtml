@model BookStoreCRM.Web.Areas.Admin.ViewModels.Category.CategoryWithSubCategoryViewModel

@{
    ViewData["Title"] = "Category Details";
}

<div class="container-fluid">

    @* Заголовок страницы *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Category Details</h2>
           
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Category
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>
        </div>
    </div>

    @* Информация о категории *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0">Category Information</h5>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <span class="text-muted">Name</span>
                </div>

                <div class="col-md-9">
                    <strong>@Model.Name</strong>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <span class="text-muted">Description</span>
                </div>

                <div class="col-md-9">
                    @if (string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <span class="text-muted">No description provided.</span>
                    }
                    else
                    {
                        <span>@Model.Description</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Подкатегории *@
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">Subcategories</h5>
                    <small class="text-muted">
                        Total: @Model.SubCategories.Count
                    </small>
                </div>

                <a asp-controller="SubCategory"
                   asp-action="Create"
                   asp-route-categoryId="@Model.Id"
                   class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Subcategory
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model.SubCategories.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-folder2-open fs-1 text-muted"></i>

                    <h5 class="mt-3 mb-1">No subcategories</h5>

                    <p class="text-muted mb-0">
                        This category does not have any subcategories yet.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Description</th>
                                <th class="text-end pe-4" style="width: 200px;">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var subCategory in Model.SubCategories)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <strong>@subCategory.Name</strong>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(subCategory.Description))
                                        {
                                            <span class="text-muted">
                                                No description
                                            </span>
                                        }
                                        else
                                        {
                                            @subCategory.Description
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <a asp-controller="SubCategory"
                                           asp-action="Edit"
                                           asp-route-id="@subCategory.Id"
                                           class="btn btn-outline-warning btn-sm me-1">
                                            <i class="bi bi-pencil-square"></i>
                                            Edit
                                        </a>

                                        <form asp-controller="SubCategory"
                                              asp-action="Delete"
                                              asp-route-subCategoryId="@subCategory.Id"
                                              asp-route-categoryId="@Model.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to delete this subcategory?');">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>