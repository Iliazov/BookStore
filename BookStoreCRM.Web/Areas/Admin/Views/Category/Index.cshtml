@model List<BookStoreCRM.Web.Areas.Admin.ViewModels.Category.CategoryViewModel>
@{
	ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h2>Categories</h2>
	<div>
		<a asp-action="Create" class="btn btn-primary">Create Category</a>
	</div>
	
</div>
<div class="card">
	<div class="card-body">
		<table class="table table-hover align-middle">
			<thead>
				<tr>
					<th>Name</th>
					<th style="width:180px">Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach(var category in Model)
				{
					<tr class="cursor:pointer"
						onclick="location.href='@Url.Action("CategoryDetail", "Category", new {area = "Admin", id=category.Id})'">
						<td>@category.Name</td>
						<td>
							 <form 
								 asp-action="Delete" 
								 asp-route-id="@category.Id"
								  method="post"
								  style="display:inline;">
							  @Html.AntiForgeryToken()
					  
							  <button type="submit" 
								  class="btn btn-danger btn-sm px-3" 
								  onclick="return confirm('Are you sure you want to delete this category?');">
								  Delete</button>
							  </form>
						</td>

					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
